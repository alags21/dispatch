# Backend: copy this file to backend/.env (no real keys in version control).
FORGEOPS_DATABASE_URL=sqlite:///./runtime/forgeops.db
FORGEOPS_RUNTIME_DIR=runtime
FORGEOPS_REPOSITORY_ROOT=../demo/repos
FORGEOPS_SANDBOX_IMAGE=forgeops-sandbox:local
FORGEOPS_API_TOKEN=
FORGEOPS_ALLOWED_ORIGIN=http://localhost:3000
FORGEOPS_PROVIDER_URL=https://api.openai.com/v1
FORGEOPS_API_KEY=
# Use provider-supported current model IDs. All three are required for live mode.
FORGEOPS_MODEL_SMALL=
FORGEOPS_MODEL_MEDIUM=
FORGEOPS_MODEL_LARGE=
# USD per million tokens. Add actual model IDs and current prices before live execution.
FORGEOPS_PRICING_JSON={}
FORGEOPS_MAX_OUTPUT_TOKENS=3000
FORGEOPS_CONTEXT_BUDGET=12000
FORGEOPS_CONTEXT_BUDGETS_JSON={"planner":8000,"engineer":12000,"security":10000,"tester":10000,"verifier":8000}
FORGEOPS_SECURITY_MINIMUM_TIER=medium
FORGEOPS_COMMAND_TIMEOUT=60
FORGEOPS_SEMGREP_ENABLED=false
